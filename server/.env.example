# ============================================================================
# CivicTrust AI — Backend Environment Configuration Example
# ============================================================================
# NEVER commit real credentials, service account keys, or API secrets to Git.
# Copy this file to .env in your local environment.
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Authentication & Security
JWT_SECRET=your-jwt-secret-key-change-in-production
OFFICER_INVITE_SECRET=MCC-OFFICER-SECRET-2026

# Data Persistence Engine
# Options: 'sqlite' (default, safe local fallback) | 'supabase' (Supabase PostgreSQL)
DATA_STORE=sqlite
DB_PATH=./data/civictrust.db

# ----------------------------------------------------------------------------
# Supabase Configuration (Required when DATA_STORE=supabase)
# ----------------------------------------------------------------------------
# 1. Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Service Role Secret Key (Bypasses RLS for secure backend operations)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. Supabase Anon Key (Public key, optional for server operations)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 4. Supabase Storage Bucket for Complaint Visual Evidence
SUPABASE_STORAGE_BUCKET=complaint-evidence
