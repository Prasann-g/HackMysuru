# CivicTrust AI — Client Environment Variables
# Copy this file to .env and set real values before running or building.
#
# VITE_API_URL: The base URL of the CivicTrust backend server.
#   - Local development: http://localhost:5000
#   - Production / demo host: https://<your-server-host>
#
# This variable is baked into the production bundle at build time.
# Set it BEFORE running: npm run build
VITE_API_URL=http://localhost:5000
