{
  "name": "civictrust-ai",
  "version": "0.1.0",
  "private": true,
  "description": "CivicTrust AI — AI-powered civic complaint verification platform for Mysuru (HackMysuru 1.0)",
  "scripts": {
    "dev": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "test:server": "npm --prefix server test",
    "preview": "npm --prefix client run preview",
    "test:e2e": "npx playwright test"
  },
  "keywords": [
    "hackmysuru",
    "civictrust",
    "verification",
    "mysuru"
  ],
  "author": "HackMysuru Team",
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.44.0",
    "@playwright/test": "^1.44.0"
  }
}
